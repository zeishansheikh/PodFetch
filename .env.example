# Source selection
ENABLED_SOURCES=youtube,pinterest,instagram
INSTAGRAM_ENABLED=true
PINTEREST_ENABLED=true
YOUTUBE_ENABLED=true

# Instagram Trending Audio Settings (Meta Graph API)
# INSTAGRAM_ACCESS_TOKEN="your_meta_graph_api_access_token_here"
# INSTAGRAM_ACCOUNT_ID="17841435006386072"
# INSTAGRAM_API_BASE_URL="https://facebook.com" # Auto-resolves to Meta Graph API endpoint
INSTAGRAM_AUDIO_MANIFEST_PATH="audio_manifest.json"
INSTAGRAM_AUDIO_TYPE="music" # 'music' for official licensed songs, 'original_sound' for user reel clips
INSTAGRAM_DRIVE_FOLDER_NAME="trending songs" # Google Drive subfolder name for Instagram audio
MIN_AUDIO_DURATION_SECONDS=5
MAX_AUDIO_DURATION_SECONDS=420
INSTAGRAM_ALLOW_RAP=false # Set to false to exclude rap/hip-hop tracks (Talha Anjum, drill, diss)
INSTAGRAM_PRIORITIZE_SAD=true # Set to true to give first priority to sad/emotional/heartbreak songs

# Pinterest settings
PREFER_VERTICAL=true
MIN_VIDEO_DURATION_SECONDS=10
MAX_VIDEO_DURATION_SECONDS=30
MIN_VIDEO_RESOLUTION=1080
PINTEREST_KEYWORDS_FILE="pinterest_keywords.txt"
# PINTEREST_ACCESS_TOKEN="your_pinterest_api_token"
# PINTEREST_SESSION_COOKIE="your_pinterest_cookie"

# List of YouTube channels to monitor (JSON array or comma-separated URLs/IDs/handles)
YOUTUBE_CHANNELS=[
    "https://www.youtube.com/@hubermanlab",
    "https://www.youtube.com/@lexfridman",
    "https://www.youtube.com/@TED",
    "https://www.youtube.com/@HardFork"
]

# Random selection limits per execution
MIN_VIDEOS_PER_RUN=1
MAX_VIDEOS_PER_RUN=3

# Target Google Drive folder ID (from the Drive folder URL)
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# Video filtering criteria
MAX_VIDEO_AGE_DAYS=30
MIN_DURATION_MINUTES=20
# MAX_DURATION_MINUTES=240 # Optional upper limit in minutes
ALLOW_SHORTS=false
ALLOW_LIVESTREAMS=false

# Google Drive organization
USE_DATE_SUBFOLDERS=true

# Execution mode (true = test mode without downloading or uploading)
DRY_RUN=false

# Storage & logging directories
DATABASE_PATH="downloads.db"
LOG_DIR="logs"
TEMP_DIR="temp"

# Downloader & performance settings
DOWNLOAD_QUALITY="1080p"
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
CONCURRENT_FRAGMENT_DOWNLOADS=8
DISCOVERY_MAX_WORKERS=6
DISCOVERY_CANDIDATE_POOL=30

# ------------------------------------------------------------------------------
# Google Drive Authentication Options (Choose either Option A or Option B)
# ------------------------------------------------------------------------------

# OPTION A: Service Account (Recommended for unattended cloud servers)
# Place your service account JSON file on the server and point to its path:
GOOGLE_SERVICE_ACCOUNT_FILE="service_account.json"
# Or provide the raw JSON content directly via environment variable:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# OPTION B: OAuth 2.0 Credentials (For personal Google Drive accounts)
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_REFRESH_TOKEN="your-refresh-token"
# GOOGLE_TOKEN_FILE="token.json"
#
# Groq API Settings for Islamic Quran Reel Builder & Nature Reel Maker
# GROQ_API_KEY="your_groq_api_key_here"
# GROQ_API_KEY_2="optional_backup_key_2"
# GROQ_API_KEY_3="optional_backup_key_3"
# GROQ_API_KEY_4="optional_backup_key_4"
# QURAN_PLAYLIST_URL="https://www.youtube.com/playlist?list=..."

# ------------------------------------------------------------------------------
# Nature Cinematic Reel Maker Settings
# ------------------------------------------------------------------------------
# NATURE_MIN_QUALITY_SCORE=65.0
# NATURE_SEARCH_LIMIT=15
# NATURE_DAILY_PROCESSING_LIMIT=10
# NATURE_COMPOSITION_MODE="crop" # 'crop', 'blurred-background', or 'fit-with-background'
# NATURE_COLOR_GRADE_PRESET="restrained_warm" # 'restrained_warm', 'golden_hour', 'cool_mist', 'none'

