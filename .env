# Production / Default configuration
ENABLED_SOURCES=youtube,pinterest
PINTEREST_ENABLED=true
YOUTUBE_ENABLED=true
PREFER_VERTICAL=true
MIN_VIDEO_DURATION_SECONDS=10
MAX_VIDEO_DURATION_SECONDS=30
MIN_VIDEO_RESOLUTION=1080
PINTEREST_KEYWORDS_FILE="pinterest_keywords.txt"

YOUTUBE_CHANNELS=[
    "https://www.youtube.com/@melrobbins",
    "https://www.youtube.com/@JayShetty",
    "https://www.youtube.com/@hubermanlab",
    "https://www.youtube.com/@AlexHormozi"
]

MIN_VIDEOS_PER_RUN=1
MAX_VIDEOS_PER_RUN=1

GOOGLE_DRIVE_FOLDER_ID="14mOs_5rZlsr5Dtp40qXf9nmGEhTYvwLg"

MAX_VIDEO_AGE_DAYS=60
MIN_DURATION_MINUTES=20
ALLOW_SHORTS=false
ALLOW_LIVESTREAMS=false

USE_DATE_SUBFOLDERS=true
DRY_RUN=false

DATABASE_PATH="downloads.db"
LOG_DIR="logs"
TEMP_DIR="temp"

DOWNLOAD_QUALITY="1080p"
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
CONCURRENT_FRAGMENT_DOWNLOADS=8
DISCOVERY_MAX_WORKERS=6
DISCOVERY_CANDIDATE_POOL=30

# Google Authentication
GOOGLE_TOKEN_FILE="token.json"
